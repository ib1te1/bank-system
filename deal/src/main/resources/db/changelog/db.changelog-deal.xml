<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.11.xsd">

    <changeSet id="1-create-clients-table" author="auto-generated">
        <rollback>
            <dropTable tableName="clients"/>
        </rollback>
        <createTable tableName="clients">

            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="middle_name" type="VARCHAR(255)"/>

            <column name="birth_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="gender" type="VARCHAR(255)"/>

            <column name="marital_status" type="VARCHAR(255)"/>

            <column name="dependent_amount" type="INT"/>

            <column name="passport" type="JSONB">
                <constraints nullable="false"/>
            </column>

            <column name="employment" type="JSONB"/>

            <column name="account_number" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2-create-credit-table" author="troshin">
        <rollback>
            <dropTable tableName="clients"/>
        </rollback>
        <createTable tableName="credits">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="amount" type="NUMERIC">
                <constraints nullable="false"/>
            </column>

            <column name="term" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="monthly_payment" type="NUMERIC">
                <constraints nullable="false"/>
            </column>

            <column name="rate" type="NUMERIC">
                <constraints nullable="false"/>
            </column>

            <column name="psk" type="NUMERIC">
                <constraints nullable="false"/>
            </column>

            <column name="payment_schedule" type="JSONB">
                <constraints nullable="false"/>
            </column>

            <column name="insurance_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>

            <column name="salary_client" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>

            <column name="credit_status" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="3-create-statement-table" author="troshin">
        <rollback>
            <dropTable tableName="clients"/>
        </rollback>
        <createTable tableName="statements">

            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="client_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="credit_id" type="UUID"/>

            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="creation_date" type="TIMESTAMP"/>

            <column name="applied_offer" type="JSONB"/>

            <column name="sign_date" type="TIMESTAMP"/>

            <column name="ses_code" type="VARCHAR(255)"/>

            <column name="status_history" type="JSONB"/>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="statements"
                baseColumnNames="client_id"
                constraintName="fk_statements_clients"
                referencedTableName="clients"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="statements"
                baseColumnNames="credit_id"
                constraintName="fk_statements_credits"
                referencedTableName="credits"
                referencedColumnNames="id"/>

    </changeSet>
</databaseChangeLog>