<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.11.xsd">

    <changeSet id="2-create-credits-table" author="troshin">
        <createTable tableName="credits">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC">
                <constraints nullable="false"/>
            </column>
            <column name="term" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_payment" type="NUMERIC">
                <constraints nullable="false"/>
            </column>
            <column name="rate" type="NUMERIC">
                <constraints nullable="false"/>
            </column>
            <column name="psk" type="NUMERIC">
                <constraints nullable="false"/>
            </column>
            <column name="payment_schedule" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="insurance_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="salary_client" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="credit_status" type="VARCHAR(255)"/>
        </createTable>
        <rollback>
            <dropTable tableName="credits"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
